[5.497, "o", "select from demo_final\r\n"]
[0.000, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.034, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  25 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "Введите команду: "]
