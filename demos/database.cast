[0.015, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                   \r \r"]
[0.012, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[JMacBook-Pro-Mihail-4% \u001b[K\u001b[?2004h"]
[5.734, "o", "\u001b[7mmake install\u001b[27m\r\r\n\u001b[7mmake run\u001b[27m\u001b[K"]
[0.455, "o", "\u001b[A\u001b[14C\u001b[27mm\u001b[27ma\u001b[27mk\u001b[27me\u001b[27m \u001b[27mi\u001b[27mn\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27ml\u001b[27ml\u001b[1B\r\u001b[27mm\u001b[27ma\u001b[27mk\u001b[27me\u001b[27m \u001b[27mr\u001b[27mu\u001b[27mn\u001b[?2004l\r\r\n"]
[0.024, "o", "uv sync --locked\r\n"]
[0.089, "o", "\u001b[2mResolved \u001b[1m5 packages\u001b[0m \u001b[2min 24ms\u001b[0m\u001b[0m\r\n"]
[0.010, "o", "\u001b[2mChecked \u001b[1m5 packages\u001b[0m \u001b[2min 3ms\u001b[0m\u001b[0m\r\n"]
[0.014, "o", "uv run database\r\n"]
[0.058, "o", "\r\n***База данных***\r\n\r\nУправление таблицами:\r\ncreate_table <имя> <столбец:тип> ... - создать таблицу\r\ndrop_table <имя> - удалить таблицу\r\nlist_tables - показать список таблиц\r\n\r\nОперации с данными:\r\ninsert into <таблица> values (<значение>, ...) - добавить запись\r\nselect from <таблица> [where <столбец> = <значение>] - выбрать записи\r\nupdate <таблица> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\ndelete from <таблица> where <столбец> = <значение> - удалить записи\r\ninfo <таблица> - информация о таблице\r\n\r\nОбщие команды:\r\nhelp - справочная информация\r\nexit - выйти\r\n\r\nУдаление таблиц и записей требует подтверждения: y — вып"]
[0.000, "o", "олнить, другой ответ — отменить.\r\n\r\n"]
[0.000, "o", "Введите команду: "]
[15.911, "o", "create_table demo_final name:str age:int is_active:bool"]
[0.278, "o", "\r\n"]
[0.005, "o", "Таблица \"demo_final\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.001, "o", "Введите команду: "]
[3.061, "o", "insert into demo_final values (\"Sergei\", 28, true)"]
[0.221, "o", "\r\n"]
[0.001, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[0.000, "o", "Запись с ID=1 успешно добавлена в таблицу \"demo_final\".\r\n"]
[0.000, "o", "Введите команду: "]
[7.049, "o", "insert into demo_final values (\"Anna\", 25, false)"]
[0.278, "o", "\r\n"]
[0.001, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[0.000, "o", "Запись с ID=2 успешно добавлена в таблицу \"demo_final\".\r\n"]
